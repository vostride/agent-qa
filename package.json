{
  "name": "agent-qa-monorepo",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "test": "pnpm run test:scripts && turbo test",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "typecheck": "turbo typecheck",
    "dev": "turbo dev",
    "clean": "turbo clean",
    "validate:skills": "node skills/scripts/validate-skills.mjs",
    "validate:agents": "node scripts/validate-agent-instructions.mjs",
    "validate:publish": "node scripts/validate-publish-surface.mjs",
    "release:docker": "node scripts/release/docker.mjs",
    "release:dry-run": "node scripts/release/dry-run.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "release:github": "node scripts/release/github-release.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "~0.18.5",
    "knip": "6.41.0",
    "publint": "~0.3.25",
    "semver": "7.7.4",
    "turbo": "~2.11.10",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  }
}
