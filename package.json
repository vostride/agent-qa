{
  "name": "agent-qa-monorepo",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "dev": "turbo dev",
    "clean": "turbo clean",
    "validate:skills": "node skills/scripts/validate-skills.mjs",
    "validate:agents": "node scripts/validate-agent-instructions.mjs",
    "validate:publish": "node scripts/validate-publish-surface.mjs",
    "validate:eval-root-hygiene": "bash scripts/413-eval-root-hygiene.sh",
    "release:docker": "node scripts/release/docker.mjs",
    "release:docker:check": "node scripts/release/docker.mjs --check-local",
    "release:dry-run": "node scripts/release/dry-run.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "release:github": "node scripts/release/github-release.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@hono/node-server": "1.19.17",
      "@wdio/utils>@puppeteer/browsers": "3.2.3",
      "adm-zip": "0.6.1",
      "basic-ftp": "5.3.1",
      "brace-expansion": "5.0.12",
      "deepmerge-ts": "8.0.2",
      "fast-xml-builder": "1.2.1",
      "hono": "4.12.34",
      "id-agent>zod": "4.6.7",
      "lodash": "4.18.1",
      "monaco-editor>dompurify": "3.4.17",
      "sharp": "0.35.5",
      "undici@7": "7.30.1",
      "webdriver>undici": "6.29.1"
    }
  },
  "devDependencies": {
    "semver": "7.7.4",
    "turbo": "~2.9.7",
    "typescript": "~6.0.3",
    "vitest": "~4.1.5"
  }
}
