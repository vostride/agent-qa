{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "entry": ["src/**/*.test-d.ts"]
    },
    "plugins/*": {
      "entry": ["src/**/*.test-d.ts", "scripts/*.mjs"]
    }
  },
  "ignoreBinaries": ["adb", "mkfifo"],
  "ignoreDependencies": [
    "publint",
    "@arethetypeswrong/core",
    "@sentry/cli",
    "@appium/base-driver",
    "@appium/base-plugin",
    "@appium/docutils",
    "@appium/http-server",
    "@appium/logger",
    "@appium/schema",
    "@appium/support",
    "@appium/types"
  ]
}
