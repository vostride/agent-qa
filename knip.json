{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "entry": ["src/**/*.test-d.ts"]
    },
    "plugins/*": {
      "entry": ["src/**/*.test-d.ts", "scripts/*.mjs"]
    }
  },
  "ignoreBinaries": ["adb", "mkfifo"],
  "ignoreDependencies": ["publint", "@arethetypeswrong/core"]
}
