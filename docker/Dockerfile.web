# =============================================================================
# agent-qa Web Testing Image
# Multi-stage build: builder (compile) → runtime (minimal)
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: builder — install deps, build, prune
# ---------------------------------------------------------------------------
FROM node:24-slim AS builder

RUN corepack enable && corepack prepare pnpm@10.6.1 --activate

WORKDIR /build

# Copy dependency manifests first for layer caching
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json NOTICE.md ./
COPY packages/agent/package.json packages/agent/
COPY packages/agent-local/package.json packages/agent-local/
COPY packages/analytics/package.json packages/analytics/
COPY packages/android/package.json packages/android/
COPY packages/arch/package.json packages/arch/
COPY packages/cli/package.json packages/cli/
COPY packages/core/package.json packages/core/
COPY packages/dashboard-server/package.json packages/dashboard-server/
COPY packages/dashboard-ui/package.json packages/dashboard-ui/
COPY packages/eval/package.json packages/eval/
COPY packages/eval-local/package.json packages/eval-local/
COPY packages/ids/package.json packages/ids/
COPY packages/ios/package.json packages/ios/
COPY packages/knowledge-local/package.json packages/knowledge-local/
COPY packages/mcp/package.json packages/mcp/
COPY packages/model/package.json packages/model/
COPY packages/runner/package.json packages/runner/
COPY packages/runner-local/package.json packages/runner-local/
COPY packages/safety/package.json packages/safety/
COPY packages/safety-local/package.json packages/safety-local/
COPY packages/schema/package.json packages/schema/
COPY packages/tools-local/package.json packages/tools-local/
COPY packages/web/package.json packages/web/

RUN pnpm install --frozen-lockfile

# Copy all source files
COPY . .

# Build all packages
RUN pnpm build

# Prune dev dependencies
RUN pnpm prune --prod

# ---------------------------------------------------------------------------
# Stage 2: runtime — browsers + agent-qa CLI
# ---------------------------------------------------------------------------
FROM node:24-slim

# Keep base utilities small; browser system packages are installed through
# the agent-qa browser installer below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /agent-qa

# Copy built monorepo from builder
COPY --from=builder /build /agent-qa
COPY LICENSE.md /licenses/agent-qa/LICENSE.md
COPY NOTICE.md /licenses/agent-qa/NOTICE.md

# Create CLI symlink so 'agent-qa' is available globally
RUN ln -s /agent-qa/packages/cli/dist/cli.js /usr/local/bin/agent-qa \
    && chmod +x /agent-qa/packages/cli/dist/cli.js

# Install agent-qa browser support through the public CLI surface.
RUN agent-qa install-browsers --all --with-deps

# Working directory for test execution (mount point)
WORKDIR /tests

LABEL org.opencontainers.image.title="agent-qa Web" \
      org.opencontainers.image.description="AI-powered testing framework with Playwright browsers" \
      org.opencontainers.image.licenses="FSL-1.1-ALv2" \
      org.opencontainers.image.vendor="Vostride"

ENTRYPOINT ["agent-qa"]
CMD ["--help"]
