{
  "name": "@vostride/agent-qa-eval-local",
  "version": "0.2.4",
  "private": false,
  "description": "StorageImplementation shell for local agent-qa cassette IO behind eval ports.",
  "keywords": [
    "agent-qa",
    "testing",
    "agent",
    "ports"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git",
    "directory": "packages/eval-local"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@vostride/agent-qa-eval": "workspace:*",
    "@vostride/agent-qa-model": "workspace:*",
    "@vostride/agent-qa-runner": "workspace:*",
    "@vostride/agent-qa-runner-local": "workspace:*",
    "@vostride/agent-qa-schema": "workspace:*",
    "ai": "6.0.174",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "~24.19.2",
    "@vostride/agent-qa-arch": "workspace:*",
    "tsdown": "~0.23.4",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  }
}
