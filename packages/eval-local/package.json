{
  "name": "@vostride/agent-qa-eval-local",
  "version": "0.1.21",
  "private": false,
  "description": "StorageImplementation shell for local agent-qa cassette IO behind eval ports.",
  "keywords": [
    "agent-qa",
    "testing",
    "agent",
    "ports"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git",
    "directory": "packages/eval-local"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./reader": {
      "types": "./dist/reader.d.ts",
      "import": "./dist/reader.js",
      "require": "./dist/reader.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@vostride/agent-qa-eval": "workspace:*",
    "@vostride/agent-qa-model": "workspace:*",
    "@vostride/agent-qa-runner": "workspace:*",
    "@vostride/agent-qa-runner-local": "workspace:*",
    "@vostride/agent-qa-safety": "workspace:*",
    "@vostride/agent-qa-schema": "workspace:*",
    "ai": "6.0.174",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "~24.12.2",
    "@vostride/agent-qa-arch": "workspace:*",
    "tsup": "~8.5.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.5"
  }
}
