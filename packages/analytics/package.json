{
  "name": "@vostride/agent-qa-analytics",
  "version": "0.2.4",
  "private": false,
  "description": "Product analytics port, closed event union, and transports for agent-qa hosts.",
  "keywords": [
    "agent-qa",
    "analytics",
    "telemetry",
    "posthog",
    "ports"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git",
    "directory": "packages/analytics"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "prebuild": "node scripts/ensure-posthog-project.cjs",
    "build": "tsdown",
    "predev": "node scripts/ensure-posthog-project.cjs",
    "dev": "tsdown --watch",
    "pretest": "node scripts/ensure-posthog-project.cjs",
    "test": "vitest run",
    "pretypecheck": "node scripts/ensure-posthog-project.cjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@vostride/agent-qa-ids": "workspace:*",
    "@vostride/agent-qa-mcp": "workspace:*",
    "@vostride/agent-qa-schema": "workspace:*",
    "id-agent": "1.0.3",
    "posthog-node": "5.33.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "~24.12.2",
    "@vostride/agent-qa-arch": "workspace:*",
    "tsdown": "~0.23.4",
    "typescript": "~6.0.3",
    "undici": "~7.28.0",
    "vitest": "~5.0.5"
  }
}
