{
  "name": "@vostride/agent-qa-model",
  "version": "0.2.5",
  "private": false,
  "description": "Model owner package for provider registry, provider SDK adapters, and language-model middleware.",
  "keywords": [
    "agent-qa",
    "testing",
    "model",
    "provider-registry"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git",
    "directory": "packages/model"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.74",
    "@ai-sdk/google": "3.0.67",
    "@ai-sdk/openai": "3.0.58",
    "@ai-sdk/provider": "3.0.10",
    "@vostride/agent-qa-schema": "workspace:*",
    "@vostride/agent-qa-safety": "workspace:*",
    "ai": "6.0.174"
  },
  "devDependencies": {
    "@types/node": "~24.19.2",
    "@vostride/agent-qa-arch": "workspace:*",
    "tsdown": "~0.23.4",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  }
}
