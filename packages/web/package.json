{
  "name": "@vostride/agent-qa-web",
  "version": "0.2.5",
  "private": false,
  "description": "agent-qa web adapter for browser automation and accessibility checks.",
  "keywords": [
    "agent-qa",
    "testing",
    "browser",
    "playwright",
    "accessibility"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git",
    "directory": "packages/web"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "smoke:dashboard": "node ./scripts/dashboard-smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@vostride/agent-qa-runner": "workspace:*",
    "@vostride/agent-qa-schema": "workspace:*",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "~24.19.2",
    "@vostride/agent-qa-arch": "workspace:*",
    "@vostride/agent-qa-core": "workspace:*",
    "tsdown": "~0.23.4",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  }
}
