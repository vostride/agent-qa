{
  "name": "@vostride/agent-qa-core",
  "version": "0.2.1",
  "private": false,
  "description": "Core agent-qa runtime, schemas, tools, and execution services.",
  "keywords": [
    "agent-qa",
    "testing",
    "automation",
    "runtime",
    "schemas"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@vostride/agent-qa-ids": "workspace:*",
    "@vostride/agent-qa-runner": "workspace:*",
    "@vostride/agent-qa-schema": "workspace:*",
    "ai": "6.0.174",
    "bytes": "3.1.2",
    "fast-xml-parser": "5.7.2",
    "glob": "13.0.6",
    "ms": "2.1.3",
    "picocolors": "1.1.1",
    "playwright-core": "1.61.0",
    "semver": "7.8.1",
    "yaml": "2.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bytes": "~3.1.5",
    "@types/ms": "~2.1.0",
    "@types/node": "~24.12.2",
    "@vostride/agent-qa-arch": "workspace:*",
    "tsup": "~8.5.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.5"
  }
}
