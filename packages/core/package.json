{
  "name": "@vostride/agent-qa-core",
  "version": "0.2.5",
  "private": false,
  "description": "Core agent-qa runtime, schemas, tools, and execution services.",
  "keywords": [
    "agent-qa",
    "testing",
    "automation",
    "runtime",
    "schemas"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./run-text-output": {
      "import": {
        "types": "./dist/run-text-output.d.ts",
        "default": "./dist/run-text-output.js"
      },
      "require": {
        "types": "./dist/run-text-output.d.cts",
        "default": "./dist/run-text-output.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@vostride/agent-qa-ids": "workspace:*",
    "@vostride/agent-qa-runner": "workspace:*",
    "@vostride/agent-qa-schema": "workspace:*",
    "ai": "7.0.159",
    "bytes": "3.1.2",
    "fast-xml-parser": "5.11.2",
    "glob": "14.0.3",
    "ms": "2.1.3",
    "picocolors": "1.1.1",
    "semver": "7.8.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bytes": "~3.1.5",
    "@types/ms": "~2.1.0",
    "@types/node": "~24.19.2",
    "@vostride/agent-qa-arch": "workspace:*",
    "tsdown": "~0.23.4",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  }
}
