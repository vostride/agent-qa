{
  "name": "@vostride/agent-qa-mcp",
  "version": "0.2.4",
  "private": false,
  "description": "Model Context Protocol server and tools for agent-qa authoring and triage.",
  "keywords": [
    "agent-qa",
    "mcp",
    "model-context-protocol",
    "testing",
    "automation"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@vostride/agent-qa-agent": "workspace:*",
    "@vostride/agent-qa-schema": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@types/node": "~24.12.2",
    "@vostride/agent-qa-arch": "workspace:*",
    "tsup": "~8.5.1",
    "typescript": "~6.0.3",
    "vitest": "~5.0.5"
  }
}
