{
  "name": "@vostride/agent-qa-runner",
  "version": "0.2.4",
  "private": false,
  "description": "Provider-neutral runner contracts and platform-adapter boundary types for agent-qa.",
  "keywords": [
    "agent-qa",
    "testing",
    "runner",
    "platform-adapter"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git",
    "directory": "packages/runner"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "regen:sequential-baseline": "vitest run src/run/__tests__/run-shell.concurrency.test.ts -u"
  },
  "dependencies": {
    "@vostride/agent-qa-safety": "workspace:*",
    "@vostride/agent-qa-schema": "workspace:*",
    "ai": "6.0.174",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "~24.12.2",
    "@vostride/agent-qa-arch": "workspace:*",
    "tsup": "~8.5.1",
    "typescript": "~6.0.3",
    "vitest": "~5.0.5"
  }
}
