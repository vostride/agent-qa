{
  "name": "@vostride/agent-qa-dashboard",
  "version": "0.2.4",
  "private": false,
  "description": "agent-qa local dashboard server, APIs, run queue, and artifact services.",
  "keywords": [
    "agent-qa",
    "dashboard",
    "testing",
    "automation",
    "server"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git",
    "directory": "packages/dashboard-server"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@vostride/agent-qa-android": "workspace:*",
    "@vostride/agent-qa-core": "workspace:*",
    "@vostride/agent-qa-ids": "workspace:*",
    "@vostride/agent-qa-ios": "workspace:*",
    "@vostride/agent-qa-model": "workspace:*",
    "@vostride/agent-qa-runner": "workspace:*",
    "@vostride/agent-qa-runner-local": "workspace:*",
    "@vostride/agent-qa-schema": "workspace:*",
    "@vostride/agent-qa-web": "workspace:*",
    "ai": "6.0.174",
    "picocolors": "1.1.1",
    "tree-kill": "1.2.2",
    "ws": "8.21.0",
    "yaml": "2.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "~24.12.2",
    "@types/ws": "~8.18.1",
    "@vostride/agent-qa-agent": "workspace:*",
    "@vostride/agent-qa-agent-local": "workspace:*",
    "@vostride/agent-qa-arch": "workspace:*",
    "tsup": "~8.5.1",
    "typescript": "~6.0.3"
  }
}
